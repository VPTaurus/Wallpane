{
  "name": "media-wall",
  "productName": "Media Wall",
  "version": "1.1.0",
  "description": "A video-wall player for local videos, images and GIFs.",
  "author": "Pavels Mazurs",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "lint": "eslint .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run test:e2e",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "build": {
    "appId": "local.mediawall.app",
    "productName": "Media Wall",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
