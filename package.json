{
  "name": "wallpane",
  "productName": "Wallpane",
  "version": "1.5.0",
  "description": "A video wall for your own videos, images and GIFs. Local files only, never online.",
  "author": "Pavels Mazurs",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/VPTaurus/wallpane"
  },
  "homepage": "https://github.com/VPTaurus/wallpane",
  "funding": "https://github.com/sponsors/VPTaurus",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "lint": "eslint .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run test:e2e",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.js",
    "predist": "node scripts/fetch-ffmpeg.js",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "build": {
    "appId": "io.github.vptaurus.wallpane",
    "productName": "Wallpane",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
